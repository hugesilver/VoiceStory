{
  "expo": {
    "name": "VoiceStory",
    "slug": "VoiceStory",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voicestory",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "dev.hugesilver.voicestory",
      "deploymentTarget": "17.0",
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "VoiceStory converts your speech to text for diary entries.",
        "NSMicrophoneUsageDescription": "VoiceStory uses your microphone to record voice diary entries.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.hugesilver.voicestory",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "./plugins/with-uiscene",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2F3A99",
          "android": {
            "image": "./assets/images/logo-mark.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 33
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "VoiceStory uses your microphone to record voice diary entries.",
          "speechRecognitionPermission": "VoiceStory converts your speech to text for diary entries.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoSansCJKkr-Regular.otf",
            "./assets/fonts/NotoSansCJKkr-Medium.otf",
            "./assets/fonts/NotoSansCJKkr-Bold.otf",
            "./assets/fonts/NotoSansCJKkr-Black.otf"
          ]
        }
      ],
      "expo-audio",
      "expo-sharing",
      "react-native-zip-archive",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-image",
      "expo-localization",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "RecordShortcut",
              "displayName": "VoiceStory",
              "description": "Open the recording screen to write a voice diary.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "RecordShortcut",
              "label": "VoiceStory",
              "description": "Open the recording screen to write a voice diary.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      "./plugins/with-widgets"
    ],
    "locales": {
      "en": "./src/locales/langs/ios/en.json",
      "ko": "./src/locales/langs/ios/ko.json",
      "ja": "./src/locales/langs/ios/ja.json",
      "zh-Hans": "./src/locales/langs/ios/zh-Hans.json",
      "zh-Hant": "./src/locales/langs/ios/zh-Hant.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "9cac2960-4cf6-411f-aa91-a67a6a926ed3"
      }
    }
  }
}
