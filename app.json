{
  "expo": {
    "name": "VoiceStory",
    "slug": "VoiceStory",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voicestory",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "dev.hugesilver.voicestory",
      "deploymentTarget": "17.0",
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true // iOS OOM 방지 설정
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.hugesilver.voicestory"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 33
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "VoiceStory uses your microphone to record voice diary entries.",
          "speechRecognitionPermission": "VoiceStory converts your speech to text for diary entries.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoSansCJKkr-Regular.otf",
            "./assets/fonts/NotoSansCJKkr-Medium.otf",
            "./assets/fonts/NotoSansCJKkr-Bold.otf",
            "./assets/fonts/NotoSansCJKkr-Black.otf"
          ]
        }
      ]
    ],
    "locales": {
      "en": "./src/locales/langs/ios/en.json",
      "ko": "./src/locales/langs/ios/ko.json",
      "ja": "./src/locales/langs/ios/ja.json",
      "zh-Hans": "./src/locales/langs/ios/zh-Hans.json",
      "zh-Hant": "./src/locales/langs/ios/zh-Hant.json"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
